# The build context for this image is frontend/, so the repository root
# .dockerignore does not apply here.
node_modules
.next
out
.env*.local
AGENTS.md
CLAUDE.md
Dockerfile

# Tests run in CI, never in the image build. They would be traced by the
# standalone output step and add weight for something the container never runs.
*.test.ts
*.test.tsx
src/test
vitest.config.mts
