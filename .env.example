# Copy to .env and fill in. .env is gitignored; never commit real credentials.

# Kaggle API — https://www.kaggle.com/settings -> Create New Token
# Alternatively place the downloaded kaggle.json at ~/.kaggle/kaggle.json
KAGGLE_USERNAME=
KAGGLE_KEY=

# Paths (defaults are fine for local development)
DATA_DIR=data
MODEL_DIR=models

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
