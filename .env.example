# Copy to .env and fill in. .env is gitignored; never commit real credentials.
#
# Every variable here is optional except the Kaggle pair, and every one has a
# working default in configs/config.yaml. A real environment variable outranks
# the YAML file, which is the direction that lets a container override a
# committed default without editing an image.
#
# Anything not listed here is not configurable by environment: src/utils/config
# rejects unknown keys rather than ignoring them, so a typo fails loudly.

# ---- Kaggle (only needed to build your own dataset) -------------------------
# https://www.kaggle.com/settings -> Create New Token
# Alternatively place the downloaded kaggle.json at ~/.kaggle/kaggle.json.
# The API never reads these — only scripts/fetch_data.py does.
KAGGLE_USERNAME=
KAGGLE_KEY=

# The source dataset. Change only if you have mirrored it somewhere else.
# KAGGLE_DATASET=davidcariboo/player-scores

# ---- Paths (defaults are fine for local development) ------------------------
DATA_DIR=data
MODEL_DIR=models

# ---- API --------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Browser origins allowed to call this API, comma-separated. Read directly by
# api/main.py rather than through the YAML, because it is deployment-specific
# and belongs nowhere near a committed default.
#
# Empty means no cross-origin access at all, which is correct for an API served
# from the same origin as its dashboard. Set it to wherever the dashboard is
# actually hosted. It is deliberately not wildcarded in docker-compose.yml: this
# API is read-only and unauthenticated today, and "*" is a habit that becomes
# wrong the moment either of those changes.
CORS_ORIGINS=http://localhost:3000
