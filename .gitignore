# ---- Python ----
__pycache__/
*.py[cod]
*.so
*.egg
*.egg-info/
dist/
build/
.venv/
venv/
env/

# ---- Environment / secrets ----
.env
.env.*
!.env.example

# ---- Data ----
# Raw and processed data are downloaded, not committed: the Kaggle source is
# ~759 MB and refreshes weekly, so committing it would be both large and stale.
# data/sample/ IS committed — the test suite runs against it so CI needs no
# network and no credentials.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/sample/

# ---- Models ----
models/*
!models/.gitkeep

# ---- Tooling ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# ---- Frontend ----
node_modules/
.next/
out/

# ---- Editors / OS ----
.vscode/
.idea/
.claude/
.DS_Store
*.swp

# Generated reports. The HTML embeds every figure as a base64 PNG so each file
# stands alone, which also makes them large and binary-ish — poor things to
# version. `python scripts/build_reports.py` regenerates them in seconds from
# the saved models. The Markdown they produce (docs/model_comparison.md, the
# model cards) IS committed: it is small, diffable, and worth reviewing.
reports/*
!reports/.gitkeep

# Frontend build output and dependencies. `npm ci && npm run build` in
# frontend/ regenerates all of it.
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/next-env.d.ts
# Regenerated by `next dev` on every run, and not authored here. Ignoring them
# keeps `git status` clean without committing generated agent scaffolding.
frontend/AGENTS.md
frontend/CLAUDE.md
frontend/.env*.local

# Stray uv lockfile. This project pins with requirements*.txt; a second,
# unmaintained lockfile in the tree is a source of confusion, not of truth.
uv.lock
